# Keep real keys in Render Environment, never commit them.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional paid clip generation. Leave disabled until the owner accepts provider costs.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
ENABLE_PAID_VIDEO_GENERATION=false

# Owner-only gate for this public website. Generate a private random value; do not share it.
VIDEO_GENERATION_ACCESS_TOKEN=replace_with_a_long_random_secret

# Optional persistent job metadata store. Use your Render Postgres connection string in production.
# If omitted, the app falls back to local SQLite (ephemeral on Render free web services).
DATABASE_URL=

# Optional durable MP4 storage (Cloudflare R2, AWS S3, Backblaze B2 S3 API, etc.).
# Keep the bucket private. If unset, clips stay on temporary local server storage.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PREFIX=reference2video
S3_PRESIGNED_URL_TTL_SECONDS=3600

# Optional override if FFmpeg is installed outside the bundled npm package.
FFMPEG_PATH=
